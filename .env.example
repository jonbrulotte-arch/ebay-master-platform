# Database
DATABASE_URL=postgresql+asyncpg://ebay_platform:ebay_platform@postgres:5432/ebay_platform
DATABASE_URL_SYNC=postgresql://ebay_platform:ebay_platform@postgres:5432/ebay_platform

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# eBay API
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=http://localhost:8000/api/v1/auth/ebay/callback
EBAY_SANDBOX=true

# AliExpress API
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# S3 / MinIO
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=ebay-platform-images
S3_PUBLIC_URL=http://localhost:9000/ebay-platform-images

# Encryption key for storing OAuth tokens
FERNET_KEY=

# Encryption key for storing OAuth tokens
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# CORS — comma-separated origins (default: http://localhost:3000)
CORS_ORIGINS=["http://localhost:3000"]

# Environment name (development|staging|production)
ENVIRONMENT=development

# Sentry error tracking (leave empty to disable)
SENTRY_DSN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
